#game-interface {
    flex-grow: 1;
    color: rgb(236, 242, 245);
    font-size: 15px;
}
.surface {
    background-color: rgba(18, 27, 35, 0.97);
    border-color: rgb(71, 96, 112);
    border-width: 1px;
    border-radius: 6px;
    padding: 12px 14px;
}
.heading {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 5px;
}
.section {
    font-size: 16px;
    color: rgb(192, 225, 242);
    -unity-font-style: bold;
    margin-top: 8px;
    margin-bottom: 4px;
}
.muted {
    color: rgb(171, 196, 209);
    font-size: 13px;
    white-space: normal;
}
Button {
    color: rgb(237, 246, 250);
    background-color: rgb(42, 66, 82);
    border-color: rgb(90, 120, 137);
    padding: 4px 9px;
    min-height: 28px;
    margin: 2px;
}
Button:hover {
    background-color: rgb(59, 92, 110);
}
Button:active {
    background-color: rgb(77, 117, 135);
}
Button:disabled {
    opacity: 0.45;
}
.row {
    flex-direction: row;
    align-items: center;
}
.grow {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
}
.main-menu {
    align-self: center;
    margin-top: 12px;
    margin-bottom: 12px;
    width: 490px;
    max-width: 96%;
    flex-shrink: 1;
}
.main-menu ScrollView, .game-panel ScrollView {
    flex-shrink: 1;
    min-height: 0;
}
.pause-menu {
    align-self: center;
    margin-top: 14%;
    width: 340px;
    max-width: 92%;
}
.form-row > DropdownField {
    flex-grow: 1;
    flex-basis: 0;
}
.unity-base-field__label {
    min-width: 76px;
    color: rgb(201, 222, 233);
}
.unity-base-field__input {
    background-color: rgb(33, 54, 68);
    color: rgb(236, 242, 245);
    border-color: rgb(90, 120, 137);
    min-height: 28px;
}
.unity-base-popup-field__text {
    color: rgb(236, 242, 245);
}
.unity-base-popup-field__arrow {
    -unity-background-image-tint-color: rgb(201, 222, 233);
}
.unity-progress-bar__background {
    background-color: rgb(42, 62, 75);
    border-color: rgb(113, 135, 149);
}
.palette {
    margin-left: 4px;
}
.swatch {
    width: 20px;
    height: 15px;
    min-height: 15px;
    padding: 0;
    border-radius: 2px;
    margin: 1px;
}
.selected-swatch {
    border-width: 2px;
    border-color: white;
}
.hero-hud {
    position: absolute;
    left: 14px;
    top: 14px;
    width: 352px;
    max-width: 39%;
}
.hero-hud .heading {
    font-size: 17px;
}
.hero-hud ProgressBar {
    height: 21px;
    margin-bottom: 3px;
}
.health-bar .unity-progress-bar__progress {
    background-color: rgb(163, 51, 63);
}
.experience-bar .unity-progress-bar__progress {
    background-color: rgb(47, 113, 157);
}
.panel-host {
    position: absolute;
    top: 14px;
    right: 14px;
    bottom: 70px;
    left: 42%;
    align-items: flex-end;
}
.game-panel {
    width: 530px;
    max-width: 100%;
    max-height: 100%;
    flex-shrink: 1;
}
.panel-title {
    justify-content: space-between;
}
.item-row {
    min-height: 36px;
    padding: 3px 5px;
    background-color: rgba(49, 75, 92, 0.44);
    margin-top: 2px;
    margin-bottom: 2px;
}
.item-icon {
    width: 33px;
    height: 33px;
    margin-right: 5px;
}
.item-name {
    white-space: normal;
}
.hunt-active {
    color: rgb(255, 221, 150);
    white-space: normal;
}
.hunt-complete {
    color: rgb(165, 229, 193);
    white-space: normal;
}
.feedback {
    position: absolute;
    left: 14px;
    right: 62%;
    bottom: 72px;
    background-color: rgba(18, 27, 35, 0.94);
    padding: 7px 10px;
    white-space: normal;
    color: rgb(255, 225, 163);
}
.action-bar {
    position: absolute;
    bottom: 12px;
    left: 14px;
    right: 14px;
    flex-wrap: wrap;
    justify-content: center;
    padding: 3px;
    background-color: rgba(18, 27, 35, 0.93);
    border-radius: 6px;
}
.map-panel {
    width: 458px;
}
.map-image {
    width: 390px;
    max-width: 100%;
    height: 390px;
    flex-shrink: 1;
    align-self: center;
    background-color: rgb(10, 20, 30);
}
.map-marker {
    position: absolute;
    translate: -50% -50%;
    padding: 1px 4px;
    color: rgb(255, 227, 145);
    background-color: rgb(23, 35, 45);
    -unity-font-style: bold;
}
.map-player {
    color: rgb(171, 238, 255);
}
.map-landmark {
    translate: -50% -125%;
}

/* ----- M0 P0 Alpha start screens -----
   Geometry and colours: AlphaStartupPresentation (StartMenuWidget 0x583320, SystemWidget 0x587710,
   GameController_buildCharacterList 0x49D650, GameController_buildWorldList 0x4A23D0). The Alpha font
   (resource1.dat) is applied at runtime by GameBootstrap.ApplyAlphaFont, so text below only sets size,
   colour and the outline pass of 0x583320. */
.alpha-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
}

.alpha-overlay {
    background-color: rgba(0, 0, 0, 0.55);
}

.alpha-center {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

/* Every Alpha text run has the 4 px black outline pass drawn behind it. */
.alpha-line {
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
    white-space: normal;
}

/* Start menu of 0x583320: three centred entries, y = 30 / 80 / 130 from the widget anchor, size 18, no frame. */
.alpha-menu {
    position: absolute;
    left: 0;
    right: 0;
    top: 56.6%;
    align-items: center;
    justify-content: flex-start;
}

.alpha-menu-item {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
    padding: 0;
    margin: 0;
    min-height: 0;
    height: 50px;
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-align: middle-center;
}

.alpha-menu-item:hover {
    /* 0x3E4CCCCD, 1.0, 1.0 — the hover colour of 0x583320 */
    color: rgb(51, 255, 255);
    background-color: rgba(0, 0, 0, 0);
}

.alpha-menu-item:active {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(51, 255, 255);
}

/* SystemWidget 0x587710: 14 px text, 30 px pitch, centred in the 350 px wide in-game widget. */
.alpha-menu-small {
    top: 50%;
}

.alpha-menu-small .alpha-menu-item {
    height: 30px;
    font-size: 14px;
}

/* Rows of 0x49D650 / 0x4A23D0: 230 px pitch (220 px frame + 10 px gap), centred, 600 px wide. */
.alpha-rows {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
}

.alpha-row {
    width: 600px;
    height: 220px;
    margin-bottom: 10px;
    padding: 0;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    background-color: rgba(26, 26, 26, 0.62);
    flex-direction: row;
    align-items: flex-start;
    -unity-text-align: middle-left;
}

.alpha-row:hover {
    background-color: rgba(38, 38, 38, 0.66);
}

.alpha-row-empty {
    justify-content: center;
    align-items: center;
    -unity-text-align: middle-center;
}

.alpha-row-preview {
    width: 200px;
    height: 216px;
    flex-shrink: 0;
}

.alpha-row-preview-image {
    width: 200px;
    height: 216px;
}

.alpha-row-preview-empty {
    background-color: rgba(0, 0, 0, 0.25);
}

.alpha-row-info {
    flex-grow: 1;
    flex-direction: column;
    padding: 22px 12px 0 0;
}

/* Alpha reveals the row action only while the row is hovered. */
.alpha-row-action {
    display: none;
    position: absolute;
    right: 20px;
    bottom: 20px;
    width: 198px;
    height: 66px;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    background-color: rgba(10, 16, 22, 0.72);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.alpha-row:hover .alpha-row-action {
    display: flex;
}

/* Framed Alpha buttons: 198x66 (Back / Select) and 298x66 (wide). */
.alpha-button {
    width: 198px;
    height: 66px;
    margin: 0;
    padding: 0;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    background-color: rgba(10, 16, 22, 0.72);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 2px;
    -unity-text-outline-color: rgb(0, 0, 0);
}

.alpha-button-wide {
    width: 298px;
}

.alpha-button:hover {
    background-color: rgba(56, 78, 98, 0.82);
    color: rgb(51, 255, 255);
}

.alpha-button:active {
    background-color: rgba(28, 44, 58, 0.9);
}

.alpha-back-slot {
    position: absolute;
    left: 30px;
    top: 51px;
}

.alpha-top-right {
    position: absolute;
    right: 28px;
    top: 51px;
}

.alpha-bottom-right {
    position: absolute;
    right: 28px;
    bottom: 28px;
}

.alpha-status {
    position: absolute;
    left: 30px;
    bottom: 22px;
    max-width: 60%;
    font-size: 13px;
}

.alpha-wait {
    background-color: rgb(0, 0, 0);
}

/* ----- Alpha character editor / world creation ----- */
.alpha-editor {
    flex-direction: column;
}

.alpha-editor-body {
    flex-direction: row;
    align-items: flex-start;
    justify-content: center;
}

.alpha-editor-preview {
    width: 280px;
    margin-right: 24px;
    align-items: center;
}

.alpha-editor-fields {
    width: 420px;
}

.alpha-editor-actions {
    margin-top: 14px;
    justify-content: center;
}

.alpha-creation {
    flex-direction: column;
    align-items: center;
    width: 520px;
}

.alpha-field {
    margin-top: 6px;
    margin-bottom: 6px;
}

.alpha-field .unity-base-field__label {
    color: rgb(127, 127, 255);
    min-width: 180px;
}

.alpha-field .unity-base-text-field__input {
    background-color: rgba(10, 16, 22, 0.72);
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    color: rgb(255, 255, 255);
    font-size: 18px;
}

.alpha-arrow {
    width: 34px;
    height: 30px;
    min-height: 0;
    margin: 0 6px 0 6px;
    padding: 0;
    border-width: 2px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    background-color: rgba(10, 16, 22, 0.72);
    color: rgb(255, 255, 255);
    font-size: 18px;
    -unity-text-align: middle-center;
}

.alpha-arrow:hover {
    color: rgb(51, 255, 255);
}

.alpha-carousel-label {
    min-width: 110px;
}

.alpha-carousel-value {
    width: 150px;
    -unity-text-align: middle-center;
}

.alpha-options {
    width: 450px;
}

/* Carousels, preview panel and option rows of the Alpha screens. */
.carousel {
    margin-top: 3px;
    margin-bottom: 3px;
    align-items: center;
}

/* OptionsWidget 0x4CF3C0 / vfunc_10 0x4D46D0: 11 rows on a 30 px pitch, label at x = 15 size 12, value centred,
   Apply / OK / Cancel in one row (widget content 450x440). */
.option-row {
    margin: 0;
    height: 30px;
    align-items: center;
}

.option-label {
    min-width: 210px;
    color: rgb(255, 255, 255);
    font-size: 12px;
    margin-left: 15px;
}

.option-value {
    width: 180px;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: 12px;
}

.option-row Button {
    width: 26px;
    height: 22px;
    min-height: 0;
    margin: 0 4px 0 4px;
    padding: 0;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    background-color: rgba(10, 16, 22, 0.72);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.option-row Button:hover {
    color: rgb(51, 255, 255);
}

.options-buttons {
    justify-content: center;
    margin-top: 14px;
}

.options-buttons Button {
    width: 110px;
    height: 30px;
    margin: 0 6px 0 6px;
    border-width: 1px;
    border-color: rgb(255, 255, 255);
    border-radius: 0;
    background-color: rgba(10, 16, 22, 0.72);
    color: rgb(255, 255, 255);
    font-size: 12px;
    -unity-text-align: middle-center;
}

.options-buttons Button:hover {
    color: rgb(51, 255, 255);
    background-color: rgba(56, 78, 98, 0.82);
}

.preview-panel {
    align-items: center;
    margin-top: 6px;
    margin-bottom: 6px;
}

.preview-image {
    width: 260px;
    height: 340px;
}

.unity-base-field__label {
    min-width: 76px;
    color: rgb(201, 222, 233);
}
